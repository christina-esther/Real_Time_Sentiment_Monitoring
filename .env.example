# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=social-posts
KAFKA_PRED_TOPIC=sentiment-predictions

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sentiment_monitor
MONGO_COLLECTION=sentiment_results

# ---- Reddit API (https://www.reddit.com/prefs/apps) ----
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=rt-sentiment-monitor/1.0 by u/yourname
REDDIT_SUBREDDITS=technology+gadgets+india+movies

# ---- Twitter / X API (optional alternative) ----
TWITTER_BEARER_TOKEN=

# ---- Model ----
MODEL_PATH=Models/best_model
ALERT_NEGATIVE_THRESHOLD=0.40
ALERT_WINDOW_MINUTES=10
